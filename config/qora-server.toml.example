[server]
bind = "0.0.0.0:443"
tls_cert = "/etc/qora/certs/fullchain.pem"
tls_key = "/etc/qora/certs/privkey.pem"

[scheduler]
slot_count = 64
max_queue = 1000
max_context = 8192
request_timeout_secs = 90

[auth]
admin_token_env = "QORA_ADMIN_TOKEN"
db_path = "/var/lib/qora/auth.redb"

[limits.default]
rpm = 60
tpm = 60000

[observability]
prometheus_bind = "127.0.0.1:9090"
log_level = "info"
log_format = "json"

# Models are loaded eagerly at startup. Each [[models]] entry registers
# a model in the runtime registry. The 'id' field is what clients use
# in the request 'model' field.

[[models]]
id = "qora-llm"                   # rename freely; this is your customer-facing model id
kind = "chat"
path = "/var/lib/qora/llm/model.qor4b"
tokenizer = "/var/lib/qora/llm/tokenizer.json"
description = "QORA hybrid LLM (text + vision)"

# To serve a larger LLM alongside, just add another entry:
# [[models]]
# id = "qora-llm-large"
# kind = "chat"
# path = "/var/lib/qora/llm-large/model.qor4b"
# tokenizer = "/var/lib/qora/llm-large/tokenizer.json"

[[models]]
id = "qora-tts"
kind = "tts"
path = "/var/lib/qora/tts/model.qora-tts"
tokenizer = "/var/lib/qora/tts/tokenizer.json"
description = "Text-to-speech with voice cloning (10 languages, 25 voices)"

[[models]]
id = "qora-stt"
kind = "stt"
path = "/var/lib/qora/stt/model.qora-stt-small"
description = "Speech-to-text (Whisper-based, multi-language)"

[[models]]
id = "qora-embed"
kind = "embedding"
path = "/var/lib/qora/rag/embed.bin"
description = "Sentence embedding (2048-dim, multilingual)"

[[models]]
id = "qora-rerank"
kind = "rerank"
path = "/var/lib/qora/rag/rerank.bin"
description = "Cross-encoder reranker"

[loading]
mode = "eager"   # "eager" loads all at startup; "lazy" on first request
